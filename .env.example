# =============================================================================
# Shared .env for Docker Compose AND local `uv run` (Mac / Windows)
# =============================================================================
# Set QSEED_HOST_PATH to the absolute path of your Q-SEED data directory.
# Examples:
#   Mac:     QSEED_HOST_PATH=/Users/you/data/Q-SEED/data
#   Windows: QSEED_HOST_PATH=D:\Careers\PythonProjects\Q-SEED\data
#
# Leave QSEED_DATA_PATH as the container mount. Outside Docker, Settings falls
# back to QSEED_HOST_PATH automatically when /data/qseed does not exist.
# Outside Docker, http://ollama:11434 is rewritten to http://localhost:11434.
# =============================================================================

QSEED_HOST_PATH=/path/to/your/Q-SEED/data
QSEED_DATA_PATH=/data/qseed

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_HOST_PORT=11434

# Used by compose profiles / docs; path & Ollama URL auto-adapt for local uv.
DOCKER=1

# Optional overrides for local-only setups (usually unnecessary):
# QSEED_DATA_PATH=/path/to/your/Q-SEED/data
# OLLAMA_BASE_URL=http://localhost:11434
# DOCKER=0

# Host-mapped Ollama from inside a container (not rewritten on host):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
