# =============================================================================
# Docker — copy to .env and set QSEED_HOST_PATH before running compose
# =============================================================================
# Required: absolute host path to your Q-SEED data directory
# Examples:
#   macOS/Linux:  QSEED_HOST_PATH=/path/to/your/Q-SEED/data
#   Windows (Compose 권장, 슬래시): QSEED_HOST_PATH=D:/Users/User/Q-SEED/data
QSEED_HOST_PATH=/path/to/your/Q-SEED/data
QSEED_DATA_PATH=/data/qseed

# Default bundled-Ollama flow (`make up`):
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# External Ollama container workflow:
# 1. make up-external
# 2. make ollama-network
# 3. OLLAMA_BASE_URL=http://ollama:11434

# Host-mapped Ollama instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_HOST_PORT=11434
DOCKER=1

# =============================================================================
# Local uv dev (uncomment when running outside Docker)
# =============================================================================
# macOS/Linux:
# QSEED_DATA_PATH=/path/to/your/Q-SEED/data
# Windows (슬래시 권장; Docker 프로필과 혼용하지 말 것):
# QSEED_DATA_PATH=D:/Users/User/Q-SEED/data
# OLLAMA_BASE_URL=http://localhost:11434
# DOCKER=0
#
# Docker로 다시 전환할 때: 위 로컬 값을 주석 처리하고
# QSEED_DATA_PATH=/data/qseed, OLLAMA_BASE_URL=http://ollama:11434, DOCKER=1 로 되돌리세요.
