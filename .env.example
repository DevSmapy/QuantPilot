# =============================================================================
# Docker — copy to .env and use with docker compose
# =============================================================================
QSEED_HOST_PATH=/Volumes/WD_BLACK/Careers/PythonProjects/Q-SEED/data
QSEED_DATA_PATH=/data/qseed

# Existing Ollama container (with llama3.2 etc.) on quantpilot_default network:
#   docker network connect quantpilot_default ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# If using host-mapped Ollama instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_HOST_PORT=11434
DOCKER=1

# =============================================================================
# Local uv dev (uncomment when running outside Docker)
# =============================================================================
# QSEED_DATA_PATH=/Volumes/WD_BLACK/Careers/PythonProjects/Q-SEED/data
# OLLAMA_BASE_URL=http://localhost:11434
# DOCKER=0
