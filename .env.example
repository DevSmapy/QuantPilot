# =============================================================================
# Docker — copy to .env and set QSEED_HOST_PATH before running compose
# =============================================================================
# Required: absolute host path to your Q-SEED data directory
QSEED_HOST_PATH=/path/to/your/Q-SEED/data
QSEED_DATA_PATH=/data/qseed

# Default bundled-Ollama flow (`make up`):
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# External Ollama container workflow:
# 1. make up-external
# 2. make ollama-network
# 3. OLLAMA_BASE_URL=http://ollama:11434

# Host-mapped Ollama instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_HOST_PORT=11434
DOCKER=1

# =============================================================================
# Local uv dev (uncomment when running outside Docker)
# =============================================================================
# QSEED_DATA_PATH=/path/to/your/Q-SEED/data
# OLLAMA_BASE_URL=http://localhost:11434
# DOCKER=0
